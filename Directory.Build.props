<?xml version="1.0" encoding="utf-8"?>
<Project>
  <!--
    Global override to disable treating warnings as errors for all C++ projects
    during the VS2022 retargeting and initial porting. Remove this file once
    individual projects have been cleaned and project-level TreatWarningAsError
    is set as desired.
  -->
  <PropertyGroup>
    <TreatWarningAsError>false</TreatWarningAsError>
  </PropertyGroup>
</Project>
